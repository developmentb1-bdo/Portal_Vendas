<%@ Master 
    Language="C#" 
    AutoEventWireup="true" 
    CodeBehind="AbtMaster.master.cs" 
    Inherits="SAPB1.WebForms.Abt.AbtMaster" 
%>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
    <head runat="server">
        <title></title>

        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">

        <!-- Bootstrap 3.3.5 -->
        <link href="<%# ResolveUrl("~/") %>bootstrap/css/bootstrap.min.css" rel="stylesheet" />

        <!-- Font Awesome -->
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">

        <!-- Ionicons -->
        <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">

        <!-- Theme style -->
        <link href="<%# ResolveUrl("~/") %>dist/css/AdminLTE.min.css" rel="stylesheet" />

        <!-- 
            AdminLTE Skins. Choose a skin from the css/skins
            folder instead of downloading all of them to reduce the load. 
        -->
        <link href="<%# ResolveUrl("~/") %>dist/css/skins/_all-skins.min.css" rel="stylesheet" />

         <!-- jQuery 2.1.4 -->
         <script src="<%# ResolveUrl("~/") %>plugins/jQuery/jQuery-2.1.4.min.js"></script>

        <asp:ContentPlaceHolder ID="head" runat="server">
        </asp:ContentPlaceHolder>
    </head>
    <body class="hold-transition skin-blue sidebar-mini">
        <div class="wrapper">
            <header class="main-header">
                <!-- Logo -->
                <a href="#" class="logo">
                    <!-- mini logo for sidebar mini 50x50 pixels -->
                    <span class="logo-mini"><b>A</b>BT</span>
                    <!-- logo for regular state and mobile devices -->
                    <span class="logo-lg"><b>Portal </b>ABT</span>
                </a>
                <!-- Header Navbar: style can be found in header.less -->
                <nav class="navbar navbar-static-top" role="navigation">
                    <!-- Sidebar toggle button-->
                    <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
                        <span class="sr-only">Toggle navigation</span>
                    </a>
                    <!-- Navbar Right Menu -->
                    <div class="navbar-custom-menu">
                        <ul class="nav navbar-nav">
                            <li class="dropdown user user-menu">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                    <%--<img src="dist/img/user2-160x160.jpg" class="user-image" alt="User Image">--%>
                                    <%--<asp:Label runat="server" ID="lda" Text="dfafdaddffd"></asp:Label>--%>
                                    <i class="fa fa-gears"></i>
                                </a>
                                <ul class="dropdown-menu">
                                    <!-- User image -->
                                    <li class="user-header">
                                        
                                    </li>
                                    <!-- Menu Body -->
                                    <li class="user-body">
                                        <!-- /.row -->
                                    </li>
                                    <!-- Menu Footer-->
                                    <li class="user-footer">
                                        <%--<div class="pull-left">
                                            <a href="#" class="btn btn-default btn-flat">Profile</a>
                                        </div>--%>
                                        <div class="pull-right">
                                            <a href="#" class="btn btn-default btn-flat">Sign out</a>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>
            <aside class="main-sidebar">
                <!-- sidebar: style can be found in sidebar.less -->
                <section class="sidebar">
                    <ul class="sidebar-menu">
                        <li class="header">MENU DE OPÇÕES</li>
                        <li>
                            <a href="<%# ResolveUrl("~/") %>CadastroProduto.aspx">
                                <i class="fa fa-edit"></i> <span>Cadastro de Produtos</span>
                            </a>
                        </li>
                        <li>
                            <a href="<%# ResolveUrl("~/") %>ListaMateriais.aspx">
                                <i class="fa fa-edit"></i> <span>Lista de Materias (BOM)</span>
                            </a>
                        </li>
                        <li>
                            <a href="<%# ResolveUrl("~/") %>PlanoProducao.aspx">
                                <i class="fa fa-edit"></i> <span>Plano de Produção</span>
                            </a>
                        </li>
                        <li>
                            <a href="<%# ResolveUrl("~/") %>Fip.aspx">
                                <i class="fa fa-edit"></i> <span>FIP</span>
                            </a>
                        </li>
                    </ul>
                </section>
                <!-- /.sidebar -->
            </aside>
            <!-- Content Wrapper. Contains page content -->
            <div class="content-wrapper">
                <!-- Main content -->
                <section class="content">    
                    <div class="row">
                        <div class="col-md-12">
                            <form id="form1" runat="server">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <img src="Imagens/logoFoton.png" />
                                        </div>
                                    </div>
                                </div>
                                
                                <asp:ScriptManager runat="server" ID="smr"></asp:ScriptManager>

                                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        
                                </asp:ContentPlaceHolder>
                            </form>
                        </div>
                    <!-- /.col -->
                    </div>
                </section>
            <!-- /.content -->
            </div>
            <!-- /.content-wrapper -->

            <footer class="main-footer">
                <div class="pull-right hidden-xs">
     
                </div>
                <strong>Copyright &copy; 2016</strong>
            </footer>
        </div>

         <!-- Bootstrap 3.3.5 -->
        <script src="<%# ResolveUrl("~/") %>bootstrap/js/bootstrap.min.js"></script>

        <!-- FastClick -->
        <script src="<%# ResolveUrl("~/") %>plugins/fastclick/fastclick.min.js"></script>

        <!-- AdminLTE App -->
        <script src="<%# ResolveUrl("~/") %>dist/js/app.min.js"></script>

        <!-- Sparkline -->
        <script src="<%# ResolveUrl("~/") %>plugins/sparkline/jquery.sparkline.min.js"></script>

        <!-- SlimScroll 1.3.0 -->
        <script src="<%# ResolveUrl("~/") %>plugins/slimScroll/jquery.slimscroll.min.js"></script>

        <!-- AdminLTE dashboard demo (This is only for demo purposes) -->
        <script src="<%# ResolveUrl("~/") %>dist/js/pages/dashboard2.js"></script>

        <!-- AdminLTE for demo purposes -->
        <script src="<%# ResolveUrl("~/") %>dist/js/demo.js"></script>
    </body>
</html>
