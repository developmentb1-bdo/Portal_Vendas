<%@ Master 
    Language="C#" 
    AutoEventWireup="true" 
    CodeBehind="FotonMaster.master.cs" 
    Inherits="SAPB1.WebForms.Foton.FotonMaster" 
%>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
    <head runat="server">
        <title></title>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">

        <link href="<%# ResolveUrl("~/") %>bootstrap/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
        <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
        <link href="<%# ResolveUrl("~/") %>dist/css/AdminLTE.min.css" rel="stylesheet" />
        <link href="<%# ResolveUrl("~/") %>dist/css/skins/_all-skins.min.css" rel="stylesheet" />
        <script src="<%# ResolveUrl("~/") %>plugins/jQuery/jQuery-2.1.4.min.js"></script>

        <asp:ContentPlaceHolder ID="head" runat="server">
           
        </asp:ContentPlaceHolder>

    </head>
    <body class="hold-transition skin-blue sidebar-mini">
        <form id="form1" runat="server">
            <div class="wrapper">
                <header class="main-header">
                    <!-- Logo -->
                    <a href="<%# ResolveUrl("~/") %>PedidoPeca.aspx" class="logo">
                        <!-- mini logo for sidebar mini 50x50 pixels -->
                        <span class="logo-mini"><b>P</b>D</span>
                        <!-- logo for regular state and mobile devices -->
                        <span class="logo-lg"><b>Portal </b>Dealer</span>
                    </a>
                    <!-- Header Navbar: style can be found in header.less -->
                    <nav class="navbar navbar-static-top" role="navigation">
                        <!-- Sidebar toggle button-->
                        <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
                            <span class="sr-only">Toggle navigation</span>
                        </a>
                        <!-- Navbar Right Menu -->
                        <div class="navbar-custom-menu">
                            <ul class="nav navbar-nav">
                                <li>
                                    <a href="<%# ResolveUrl("~/") %>Login.aspx" class="btn btn-danger">Logoff</a>
                                </li>
                                <li class="dropdown user user-menu">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                        <%--<img src="dist/img/user2-160x160.jpg" class="user-image" alt="User Image">--%>
                                        <asp:Label runat="server" ID="lblNomeBarra" Text="Indefinido"></asp:Label>
                                        
                                    </a>
                                    <ul class="dropdown-menu">
                                        <!-- User image -->
                                        <li class="user-header">
                                            
                                        </li>
                                        <!-- Menu Body -->
                                        <li class="user-body">
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <label>Usuário:</label>
                                                         <asp:Label
                                                            runat="server"
                                                            ID="lblUsuario"
                                                            Text="Indefinido">
                                                        </asp:Label>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                        <!-- Menu Footer-->
                                        <li class="user-footer">
                                            <%--<div class="pull-left">
                                           
                                            </div>--%>
                                            <div class="pull-right">
                                                <a href="<%# ResolveUrl("~/") %>Login.aspx" class="btn btn-danger">Sair</a>
                                            </div>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </nav>
                </header>
                <aside class="main-sidebar">
                    <!-- sidebar: style can be found in sidebar.less -->
                    <section class="sidebar">
                        <ul class="sidebar-menu">
                            <li class="header">MENU DE OPÇÕES</li>
                            <%--<li>
                                <a href="<%# ResolveUrl("~/") %>DashboardGerencial.aspx">
                                    <i class="fa fa-dashboard"></i> <span>Dashboard Gerencial</span>
                                </a>
                            </li>--%>
                            <li>
                                <a href="<%# ResolveUrl("~/") %>TabelaPreco_Action.aspx">
                                    <i class="fa fa-table"></i> <span>Tabela de Preço</span>
                                </a>
                            </li>
                            <li class="treeview">
                                <a href="#">
                                    <i class="fa fa-edit"></i>
                                    <span>Pedido de Peça</span>
                                    <span class="fa fa-angle-left pull-right"></span>
                                </a>
                                <ul class="treeview-menu">
                                    <li><a href="<%# ResolveUrl("~/") %>PedidoPeca.aspx"><i class="fa fa-circle-o"></i> <span>Consultar</span></a></li>
                                    <li><a href="<%# ResolveUrl("~/") %>PedidoPeca_Action.aspx"><i class="fa fa-circle-o"></i> <span>Inserir</span></a></li>
                                </ul>
                            </li>
                            <li class="treeview">
                                <a href="#">
                                    <i class="fa fa-edit"></i>
                                    <span>Solictação de Garantia</span>
                                    <span class="fa fa-angle-left pull-right"></span>
                                </a>
                                <ul class="treeview-menu">
                                    <li><a href="<%# ResolveUrl("~/") %>SolicitacaoGarantia.aspx"><i class="fa fa-circle-o"></i><span>Consultar</span></a></li>
                                    <li><a href="<%# ResolveUrl("~/") %>SolicitacaoGarantia_Action.aspx"><i class="fa fa-circle-o"></i><span>Inserir</span></a></li>
                                </ul>
                            </li>
                        </ul>
                    </section>
                    <!-- /.sidebar -->
                </aside>
                <!-- Content Wrapper. Contains page content -->
                <div class="content-wrapper">
                    <!-- Main content -->
                    <section class="content">    
                        <div class="row">
                            <div class="col-md-12">
                            
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <img src="Imagens/logoFoton.png" />
                                            </div>
                                        </div>
                                    </div>
                                
                                    <asp:ScriptManager runat="server" ID="smr"></asp:ScriptManager>

                                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        
                                    </asp:ContentPlaceHolder>
                            </div>
                        <!-- /.col -->
                        </div>
                    </section>
                <!-- /.content -->
                </div>
                <!-- /.content-wrapper -->

                <footer class="main-footer">
                    <div class="pull-right hidden-xs">
     
                    </div>
                    <strong>Copyright &copy; <%= DateTime.Now.Year.ToString() %> <a href="http://www.fotonmotors.com.br/">Foton</a>.</strong>
                </footer>
            </div>

            <script src="<%# ResolveUrl("~/") %>bootstrap/js/bootstrap.min.js"></script>
            <script src="<%# ResolveUrl("~/") %>plugins/fastclick/fastclick.min.js"></script>
            <script src="<%# ResolveUrl("~/") %>dist/js/app.min.js"></script>
            <script src="<%# ResolveUrl("~/") %>plugins/sparkline/jquery.sparkline.min.js"></script>
            <script src="<%# ResolveUrl("~/") %>plugins/slimScroll/jquery.slimscroll.min.js"></script>
            <script src="<%# ResolveUrl("~/") %>dist/js/pages/dashboard2.js"></script>
            <script src="<%# ResolveUrl("~/") %>dist/js/demo.js"></script>
        </form>
    </body>
</html>
