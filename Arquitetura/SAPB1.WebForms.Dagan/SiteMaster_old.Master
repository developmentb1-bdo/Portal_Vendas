<%@ Master 
    Language="C#" 
    AutoEventWireup="true" 
    CodeBehind="SiteMaster.master.cs" 
    Inherits="SAPB1.WebForms.Dagan.SiteMaster" 
%>

<!DOCTYPE html>

<html>
    <head runat="server">
        <title></title>
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport" />
        <link id="Link1" type="image/x-icon" href="../Images/favicon.ico" rel="shortcut icon" />
        <link href="<%# ResolveUrl("~/") %>bootstrap/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
        <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
        <link href="<%# ResolveUrl("~/") %>dist/css/AdminLTE.min.css" rel="stylesheet" />
        <link href="<%# ResolveUrl("~/") %>dist/css/skins/_all-skins.min.css" rel="stylesheet" />
        <script src="<%# ResolveUrl("~/") %>plugins/jQuery/jQuery-2.1.4.min.js"></script>

        <asp:ContentPlaceHolder ID="head" runat="server">
           
        </asp:ContentPlaceHolder>
    </head>
    <body class="hold-transition skin-blue-light sidebar-mini">
       <form id="form1" runat="server" DefaultButton="btnDisableEnter">
           <asp:Button ID="btnDisableEnter" runat="server" Text="" 
            OnClientClick="return false;" style="display: none;" />
            <div class="wrapper">
                <header class="main-header">
                    <!-- Logo -->
                    <a href="<%= Page.ResolveUrl("~/Dashboard.aspx") %>" class="logo">
                        <!-- mini logo for sidebar mini 50x50 pixels -->
                        <span class="logo-mini"><b>V</b>O</span>
                        <!-- logo for regular state and mobile devices -->
                        <span class="logo-lg"><b>VeExpress</b>One</span><%--<img src="<%= Page.ResolveUrl("~/Images/logotipo-Cor-Branco.png") %>" height="65" width="100" />--%>
                    </a>
                    <!-- Header Navbar: style can be found in header.less -->
                    <nav class="navbar navbar-static-top" role="navigation">
                        <!-- Sidebar toggle button-->
                        <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
                            <span class="sr-only">Toggle navigation</span>
                        </a>
                        <!-- Navbar Right Menu -->
                        <div class="navbar-custom-menu">
                            <ul class="nav navbar-nav">
                                <li class="dropdown user user-menu">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                        <%--<img src="dist/img/user2-160x160.jpg" class="user-image" alt="User Image">--%>
                                        <%--<asp:Label runat="server" ID="lda" Text="dfafdaddffd"></asp:Label>--%>
                                        <i class="fa fa-gears"></i>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <!-- User image -->
                                        <li class="user-header">
                                            <%--<img src="dist/img/user2-160x160.jpg" class="img-circle" alt="User Image">
                                            <p>
                                                Alexander Pierce - Web Developer
                                                <small>Member since Nov. 2012</small>
                                            </p>--%>
                                        </li>
                                        <!-- Menu Body -->
                                        <li class="user-body">
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <label>Usuário:</label>
                                                        <asp:Label
                                                            runat="server"
                                                            ID="lblNomeUsuario">
                                                        </asp:Label>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                        <!-- Menu Footer-->
                                        <li class="user-footer">
                                            <div class="pull-right">
                                                <asp:Button
                                                    runat="server"
                                                    ID="btnLogout"
                                                    Text="Sair" 
                                                    CssClass="btn btn-warning"
                                                    OnClick="btnLogout_Click"/>
                                            </div>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </nav>
                </header>
                <aside class="main-sidebar">
                    <!-- sidebar: style can be found in sidebar.less -->
                    <section class="sidebar">
                        <!-- Sidebar user panel -->
                        <ul class="sidebar-menu">
                            <li class="header">MENU DE OPÇÕES</li>
                            <li class="treeview">
                                <a href="#">
                                    <i class="fa  fa-edit"></i> <span>Cadastros</span>
                                    <i class="fa fa-angle-left pull-right"></i>
                                </a>
                                <ul class="treeview-menu">
                                    <li><a href="<%= Page.ResolveUrl("~/ParceiroNegocio.aspx") %>"><i class="fa fa-circle-o"></i> Cliente</a></li>
                                    <li><a href="<%= Page.ResolveUrl("~/ParceiroNegocioPreCadastro.aspx") %>"><i class="fa fa-circle-o"></i> Pré Cadastro Cliente</a></li>
                                </ul>
                            </li>
                            <li class="treeview">
                                <a href="#">
                                    <i class="fa fa-money"></i> <span>Faturamento</span>
                                    <i class="fa fa-angle-left pull-right"></i>
                                </a>
                                <ul class="treeview-menu">
                                    <li><a href="<%= Page.ResolveUrl("~/PedidoVenda.aspx") %>"><i class="fa fa-circle-o"></i> Pedido de Venda</a></li>
                                    <li><a href="<%= Page.ResolveUrl("~/Estoque.aspx") %>"><i class="fa fa-circle-o"></i> Estoque</a></li>
                                </ul>
                            </li>
                            <li class="treeview">
                                <a href="#">
                                    <i class="fa fa-info-circle"></i> <span>Ajuda</span>
                                    <i class="fa fa-angle-left pull-right"></i>
                                </a>
                                <ul class="treeview-menu">
                                    <li><a href="<%= Page.ResolveUrl("~/VideoAjuda.aspx") %>"><i class="fa fa-circle-o"></i> Vídeo</a></li>
                                </ul>
                            </li>
                        </ul>
                    </section>
                    <!-- /.sidebar -->
                </aside>
                <!-- Content Wrapper. Contains page content -->
                <div class="content-wrapper">
                    <section class="content">
                        <div class="row">
                            <div class="col-md-12">
                                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        
                                </asp:ContentPlaceHolder>
                            </div>
                        <!-- /.col -->
                        </div>
                    </section>
                <!-- /.content -->
                </div>
                <!-- /.content-wrapper -->

                <footer class="main-footer">
                    <div class="pull-right hidden-xs">
     
                    </div>
                    <strong></strong>
                </footer>
                <div class="control-sidebar-bg"></div>
            </div>

            <script src="<%: ResolveUrl("~/") %>bootstrap/js/bootstrap.min.js"></script>
            <script src="<%: ResolveUrl("~/") %>plugins/fastclick/fastclick.min.js"></script>
            <script src="<%: ResolveUrl("~/") %>dist/js/app.min.js"></script>
            <script src="<%: ResolveUrl("~/") %>plugins/sparkline/jquery.sparkline.min.js"></script>
            <script src="<%: ResolveUrl("~/") %>plugins/slimScroll/jquery.slimscroll.min.js"></script>
            <script src="<%: ResolveUrl("~/") %>dist/js/pages/dashboard2.js"></script>
            <script src="<%: ResolveUrl("~/") %>dist/js/demo.js"></script>
            <script src="<%: ResolveUrl("~/") %>plugins/input-mask/jquery.inputmask.js"></script>
            <script src="<%: ResolveUrl("~/") %>plugins/input-mask/jquery.inputmask.date.extensions.js"></script>
            <script src="<%: ResolveUrl("~/") %>plugins/input-mask/jquery.inputmask.extensions.js"></script>
        </form>
    </body>
</html>
