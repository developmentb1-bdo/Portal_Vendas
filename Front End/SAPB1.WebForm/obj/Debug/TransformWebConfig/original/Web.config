<?xml version="1.0"?>

<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->

<configuration>
  <appSettings>
    <!--Selecionar uma camada de manipulação de dados.-->
    <add key="CamadaDAL" value="SAPB1.SqlServerDAL"/>
    <add key="UserPortal" value="RDT01PV"/>
  </appSettings>
  <!--Define qual banco de dados será utilizado. Com credenciais criptografadas para segurança das informações.-->
  <connectionStrings>
    <!--String de conexão para desenvolvimento. Banco DemoBr-->
    <add name="SqlServerConexao" providerName="System.Data.SqlClient" connectionString="Data Source=SRV-SAP;Initial Catalog=SBO_DAGAN_TST;Integrated Security=False;User ID=sa;Password=b1admin;Connect Timeout=30"/>
  </connectionStrings>
  <system.web>
    <!--Define a padronização de idioma e cultura da aplicação.-->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="pt-br" uiCulture="pt-br"/>
    <compilation debug="true" targetFramework="4.0" />
    <httpRuntime maxRequestLength="300000"/>
  </system.web>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="WsIntegraSoap" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost:8084/WsIntegra.asmx" binding="basicHttpBinding"
          bindingConfiguration="WsIntegraSoap" contract="SAP.Web.Services.WsIntegra.WsIntegraSoap"
          name="WsIntegraSoap" />
    </client>
  </system.serviceModel>
</configuration>